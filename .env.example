# Deployment values for this environment. Copy to `.env` and fill in.
#
#   cp .env.example .env      # then edit .env with your real values
#
# `.env` is gitignored and must never be committed. This template is committed
# so a fresh clone knows what has to be supplied.
#
# Nothing here is secret except the Confluent credentials, and those are only
# needed to seed the Databricks secret scope once (and to run kafka_producer.py
# locally). The pipeline itself reads them from `{{secrets/cascade/...}}`, never
# from this file.

# --- ADLS Gen2 -------------------------------------------------------------
# Substituted into jobs_config.json at deploy time, and expanded into the
# abfss:// paths in config.yaml at runtime. These are NOT credentials - access
# is granted by the Unity Catalog external location and its Access Connector
# managed identity, not by knowing the account name.
ADLS_ACCOUNT=your-storage-account
ADLS_CONTAINER=your-container

# --- Unity Catalog ---------------------------------------------------------
# Must match `databricks.catalog` in config.yaml.
CASCADE_CATALOG=cascade

# --- Databricks ------------------------------------------------------------
DATABRICKS_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net
DATABRICKS_AUTH_TYPE=azure-cli

# --- Confluent Cloud -------------------------------------------------------
# Needed to seed the secret scope and to run kafka_producer.py locally.
# Use a CLUSTER-scoped API key; a Cloud API key manages control-plane
# resources and cannot authenticate a Kafka connection.
CONFLUENT_BOOTSTRAP=pkc-xxxxx.<region>.<cloud>.confluent.cloud:9092
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=
